    "        print(\"-\" * 50)\n",
    "        \n",
    "        print(f\"Оригинальная таблица:\\n {current_df}\")\n",
    "        print(f\"Очищенная таблица:\\n {clean_df}\")\n",
    "        print(\"\\n\" + \"=\"*50 + \"\\n\")\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"Ошибка при чтении файла {file_path}: {e}\\n\")\n"
